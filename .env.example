# SentinelMAT Environment Configuration

# Backend API
PORT=5000
NODE_ENV=development

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentinelmat
DB_USER=postgres
DB_PASSWORD=

# MATLAB Analysis Integration
# Modes: docker_octave (default reliable), octave (local CLI), matlab (native CLI)
MATLAB_EXEC_MODE=docker_octave
OCTAVE_DOCKER_IMAGE=gnuoctave/octave:latest
MATLAB_CODE_DIR=../matlab
MATLAB_TIMEOUT_MS=45000

# Periodic Analysis Scheduler
ANALYSIS_INTERVAL_SEC=30
SAMPLE_WINDOW_MINUTES=60
MIN_SAMPLES_REQUIRED=5

# Telegram Bot Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Collector Configuration
SENTINELMAT_BACKEND_URL=http://localhost:5000
SENTINELMAT_INTERVAL_SEC=5.0
SENTINELMAT_DISK_PATH=/
